# Sentinel Environment Configuration
# Copy to .env and adjust as needed

# Host & Port configuration
PORT=8000
HOST=127.0.0.1

# Enable Heavy ML models (Presidio NER spaCy + Detoxify BERT)
# Set to 'false' (default) for instant sub-second startup and fast regex-only fallback
# Set to 'true' if PyTorch/spacy models are warmed up and installed
ENABLE_HEAVY_ML=false

# Background traffic simulator for live SOC dashboard stream
SIMULATE_TRAFFIC=true

# Allowed CORS origins (comma-separated, default is * for local demo)
CORS_ORIGINS=*
